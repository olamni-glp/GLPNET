glp_runtime/build/
.DS_Store

# .NET build artefacts (under tools/d2net/ and elsewhere)
**/bin/
**/obj/

# Node.js (prereq-patterns/pglite, etc.)
**/node_modules/

# Python (codeconv/)
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# Claude Code harness ephemerals
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/settings.local.json.mine

# d2net-scaffold output (regenerable; do not commit)
glp_runtime_net/

# D2NET workspace data (per-machine PostgreSQL data dir + workspace settings)
.D2NET/

# Unified PGLite data dir (FR-029) — runtime cluster files, sidecar, log
.pgdb/

# Sibling cross-process lock dir for the unified bridge (proper-lockfile)
.pgdb.bridge.lock/

# Sibling per-process consumer registry for the unified bridge (orphan-detection)
.pgdb.consumers/

# Sibling shutdown marker for non-destructive force shutdown
.pgdb.shutdown

# D2NET pgdb migration backups (FR-029) — kept on disk by D2Net.PgdbMigrate
.D2NET/pgdb.bak.*/

