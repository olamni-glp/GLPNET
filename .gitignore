.DS_Store

# bk-guardian local host state (never committed): backups, the host-local
# absolute backup path, and the local catalog schema baseline.
.specify/guardian/backups/
.specify/guardian/backup.path
.specify/guardian/schema-baseline.json

# Build artefacts (bin/obj — generic; tools/d2net/ removed feature 016)
**/bin/
**/obj/

# Keep the .codeconv/ inventory tree (FR-029 checked-in) under bin/ subdirs
!.codeconv/**/bin/
!.codeconv/**/bin/**

# Allow codeconv-produced .cs at out/csharp/bin/ (Dart `bin/` → C# `bin/` source
# convention from the dart_csharp langpair). dotnet's Debug/Release output is
# still ignored by the patterns below.
!out/csharp/bin/
out/csharp/bin/Debug/
out/csharp/bin/Release/
out/csharp/bin/obj/

# Node.js (prereq-patterns/pglite, etc.)
**/node_modules/

# Python (codeconv/)
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# Claude Code harness ephemerals
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/settings.local.json.mine

# codeconv scaffold output (regenerable; do not commit)
glp_runtime_net/

# codeconv scaffold staging dirs (atomic-move scratch; never committed)
*.codeconv-scaffold-tmp/
*.codeconv-scaffold-old/

# Legacy D2NET workspace data (toolchain removed feature 016; left ignored
# so any pre-existing on-disk .D2NET/ on operator machines is not surfaced)
.D2NET/

# Unified PGLite data dir (FR-029) — runtime cluster files, sidecar, log
.pgdb/

# Sibling cross-process lock dir for the unified bridge (proper-lockfile)
.pgdb.bridge.lock/

# Sibling per-process consumer registry for the unified bridge (orphan-detection)
.pgdb.consumers/

# Sibling shutdown marker for non-destructive force shutdown
.pgdb.shutdown

# Legacy D2NET pgdb migration backups (D2Net.PgdbMigrate removed feature
# 016; kept ignored so any historical on-disk backup is not surfaced)
.D2NET/pgdb.bak.*/

# Retired PGLite cluster filesets + snapshot archives (backup only, never restored live)
.dbsnapshots/

# codeconv-depgraph local artefact (feature 015 / R10) — recomputable per
# `codeconv depgraph compute`; NOT checked in (tombstones are the durable
# round-trip source). Tombstones under .codeconv/tombstones/ stay tracked.
.codeconv/depgraph.json

# codeconv-enrich per-run audit logs (feature 035) — regenerated each
# `codeconv enrich run`; NOT checked in (the durable reviewable record is the
# enriched provenance in .codeconv/tombstones/, FR-014). Same discipline as
# depgraph.json above.
.codeconv/enrich-runs/

# codeconv-codegen (feature 019 / R11, resolved 2026-05-23):
#   - out/csharp/  → COMMITTED (reviewable, build-gated product; NOT ignored).
#   - .codeconv/conversion-code/  → COMMITTED (escalations report + reviews log).
#   - .codeconv/codegen-prompt/optimized.md  → COMMITTED (optimizer→prod handoff).
#   - .codeconv/codegen-prompt/{_base,<subsystem>}.md  → COMMITTED (feature 020
#     per-subsystem GEPA prompts; the durable curriculum resume points).
# Ignored (regenerable, pre-promotion / offline-only — feature 020):
#   - the optimizer's scratch candidates (global + per-subsystem)
#   - the GEPA generator's offline scratch .cs (never enters out/csharp)
.codeconv/codegen-prompt/.candidate*.md
.codeconv/codegen-prompt/.gepa-scratch/


# buildkit upgrade/migration local backups (opaque state; not versioned)
.buildkit-upgrade-backup/

# buildkit pipeline pgdb (PGLite+DBOS local cluster; regenerable state, not versioned)
pgdb/
pgdb.consumers/

# buildkit-codexreview advisory review artifacts (local-only; never pushed)
reviews/
.specify/.deploy-migrated

# buildkit refine guidance cache (regenerable, per-machine; resolved each stage)
.specify/.refine-cache/

# buildkit-co observability lake (DuckDB/parquet; regenerable, per-machine)
.specify/co-lake/
.specify/deploy-ledger.jsonl

# 036/049 shared-cert material (SPKI-pinned; .pfx must never be committed)
# RESOLVED (067 T002 / 069, 2026-08-10): the four tracked files (glpquick.key/.pem/.pfx/
# .fingerprint) were untracked by feature 069 (v2026.08.10.1) and the pin rotated to 3rd-gen
# material. The gen-1 key remains in git history on the public origin — ruled NO-PURGE
# (irreversibly disclosed; dead pin); treat it as public knowledge and never re-trust it.
#
# STATUS (2026-08-11, olamnit F7 / issue C1): this rule is now EFFECTIVE. The four files
# (glpquick.key/.pem/.pfx/.fingerprint) are no longer tracked at HEAD, so gitignore applies again
# and freshly generated material stays out of the index. Verified with `git check-ignore -v`.
#
# The 2026-08-04 WARNING that this rule was INERT was correct at the time and is now superseded.
#
# What remains true: the ORIGINAL material is still in public history. Commit 94fbe87d
# ("release: v2026.07.09.1") added all four files and is reachable from origin/main, origin/develop
# and 10+ origin branches. That key is COMPROMISED and has been ROTATED — the revoked SPKI pin is
# 0LOmLNM0HYv79Rkoasuu6L4MKGRyg7axgJufbZBcyTo= and must never be trusted again by any peer.
#
# History rewrite (F7b) is still outstanding and is deliberately NOT done from a single host —
# a one-host rewrite forks the other two. It is scheduled as a coordinated window. Note that a
# rewrite alone would not have remediated this: GitHub keeps orphaned commits reachable by SHA
# until Support garbage-collects them. Rotation is what invalidated the exposure.
glpquick-cert/

# 067 derived per-device provisioning material (short-lived certs minted per provisioning
# session) + the append-only provisioning stores. Never tracked; not yet in the tree.
glpquick-derived/
glpquick-cert/provision/

