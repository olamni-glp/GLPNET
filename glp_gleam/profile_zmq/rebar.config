%% ZMQ transport provisioning (feature 059, owner ruling 2026-07-23).
%%
%% A minimal rebar3 app whose only job is to fetch + build the `erlzmq` NIF
%% (a binding over native libzmq) for the BEAM, so the Gleam ZMQ leaf
%% (glp_gleam/src/glp/link/transports/zmq.gleam via glp_link_zmq_ffi) can call
%% erlzmq at runtime. Mirrors gleam_quic/profile_c/rebar.config (the Profile-C
%% quicer provisioning) — same "native NIF, WSL/Linux-only" shape.
%%
%% Build (Linux/WSL; requires native libzmq — `apt install libzmq3-dev`):
%%   cd glp_gleam/profile_zmq && rebar3 compile
%% then set ERL_LIBS to this app's _build/default/lib.
%%
%% Version note: erlzmq2 is the canonical NIF binding. Pinned by git to keep the
%% source explicit; the exact ref is finalized against this host's OTP at
%% provisioning time (see README.md). The C build links against system libzmq.
{deps, [{erlzmq, {git, "https://github.com/zeromq/erlzmq2.git", {branch, "master"}}}]}.
