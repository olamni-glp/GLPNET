<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D2Net.Init</RootNamespace>
    <AssemblyName>d2net-init</AssemblyName>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\db-schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pgbridge\**"
          Exclude="pgbridge\node_modules\.bin\**;pgbridge\node_modules\.cache\**"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsurePgBridgeNodeModules"
          BeforeTargets="VerifyPgBridgeDeps;Build"
          Inputs="pgbridge\package-lock.json"
          Outputs="pgbridge\node_modules\.npm-ci-stamp">
    <Message Text="Running 'npm ci' in pgbridge\ to materialize the PGLite bundle..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="pgbridge" ConsoleToMSBuild="true" />
    <Touch Files="pgbridge\node_modules\.npm-ci-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="VerifyPgBridgeDeps" BeforeTargets="Build" DependsOnTargets="EnsurePgBridgeNodeModules">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\..\..\scripts\verify-pgbridge-deps.ps1&quot; -BridgeDir &quot;$(MSBuildThisFileDirectory)pgbridge&quot;"
          ConsoleToMSBuild="true" />
  </Target>

</Project>
