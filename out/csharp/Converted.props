<!--
  Codegen-managed compile list (feature 020, imported by glp_runtime_net.csproj).

  Each accepted Dart→C# conversion appends one <Compile Include="..."/> here,
  scoping the library build to files that passed the codeconv-codegen
  build-gate. Append-only; codegen never removes entries (a divergent
  re-conversion overwrites the .cs in place, the include stays).

  Initial state: EMPTY — the bulk codegen drive has not started.
-->
<Project>
  <ItemGroup>
    <!-- codeconv-codegen append point — keep one entry per line, sorted. -->
    <Compile Include="lib/analysis/analysis_phase.cs" />
    <Compile Include="lib/analysis/type_checker/mode.cs" />
    <Compile Include="lib/analysis/type_checker/moded_term.cs" />
    <Compile Include="lib/analysis/type_checker/prelude.cs" />
    <Compile Include="lib/analysis/type_checker/type_ast.cs" />
    <Compile Include="lib/bytecode/opcodes.cs" />
    <Compile Include="lib/bytecode/opcodes_v2.cs" />
    <Compile Include="lib/compiler/error.cs" />
    <Compile Include="lib/compiler/pmt/errors.cs" />
    <Compile Include="lib/compiler/token.cs" />
    <Compile Include="lib/engine/claude_adapter.cs" />
    <Compile Include="lib/glp_runtime.cs" />
    <Compile Include="lib/multiagent/boot_loader.cs" />
    <Compile Include="lib/multiagent/global_writers_table.cs" />
    <Compile Include="lib/multiagent/message_queue.cs" />
    <Compile Include="lib/multiagent/repl_play_runner.cs" />
    <Compile Include="lib/runtime/cells.cs" />
    <Compile Include="lib/runtime/machine_state.cs" />
    <Compile Include="lib/runtime/suspension.cs" />
    <Compile Include="lib/runtime/terms.cs" />
  </ItemGroup>
</Project>
