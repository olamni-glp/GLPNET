<!--
  glp_repl — the converted C# REPL executable (feature 020, T017 target).

  An executable project that links the glp_runtime_net library. While the
  bulk codegen drive is in flight the entrypoint (Program.cs) is a minimal
  placeholder; once the runtime/heap/bytecode/compiler subsystems convert,
  T017 replaces Program.cs (and adds the structured `:trace` instrumentation
  the differential oracle compares against the Dart golden).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.Repl</RootNamespace>
    <AssemblyName>glp_repl</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_runtime_net.csproj" />
    <!-- feature 025: the hand-authored link layer (kernels + transports). The exe is the
         composition root that wires it into the REPL engine; the dependency flows
         exe -> GlpLink -> glp_runtime_net (a DAG; the library never references GlpLink). -->
    <ProjectReference Include="..\..\..\csharp\glp_link\GlpLink.csproj" />
    <!-- feature 050 US2: the crdtmsg payload codec (glp_crdtmsg → GlpLink). The composition root
         is the sanctioned place to reference both leaves (research D-1 cycle resolution): it injects
         CrdtMsgPayloadCodec for the "quic" scheme so glp_link stays codec-agnostic. -->
    <ProjectReference Include="..\..\..\csharp\glp_crdtmsg\GlpCrdtMsg.csproj" />
  </ItemGroup>

</Project>
