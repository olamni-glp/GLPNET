<!--
  glp_runtime_net — the converted-C# GLP runtime library (feature 020).

  Layered project so partial conversion still compiles:
    * `EnableDefaultCompileItems=false` disables the default `**/*.cs` glob
      — the 177 feature-016 scaffold stubs under this tree still carry their
      mirrored Dart source verbatim and would not compile if globbed.
    * `Converted.props` (imported below) holds the EXPLICIT `<Compile
      Include="..."/>` list. It starts empty; the codegen workflow appends to
      it as each file passes the build-gate (the `/codeconv-codegen` accept).
    * Build-gating therefore scopes to files the codegen has accepted, not
      to whatever stubs happen to live alongside them.

  Target framework: net11.0 — engineer mandate 2026-09-01 (".net 8, 9 and 10 are
  obsolete; migrate all code to .net 11"). This comment previously read net10.0
  while the element below already said net11.0; the stale half is corrected here
  because at least one peer lane vendors this file and reads this header.
  Package versions come from the repo-root Directory.Packages.props (CPM,
  engineer ruling Q-shiras-36) — never add a Version= attribute here.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime</RootNamespace>
    <AssemblyName>glp_runtime_net</AssemblyName>
    <!--
      The scaffold stubs under out/csharp/lib/ still carry mirrored Dart
      source; disabling the default glob keeps them out of compilation
      until the codegen workflow promotes them into Converted.props.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The codegen-managed compile list (one <Compile Include="..." /> per
       accepted file). Empty at the start of the bulk-codegen drive. -->
  <Import Project="Converted.props" Condition="Exists('Converted.props')" />

  <!-- Feature-020 trace-equivalence instrumentation: hand-written candidate-side
       code (NOT a codegen-converted Dart file), so it is listed here explicitly
       rather than in the codegen-managed Converted.props. Emits the canonical
       EV/OUT wire format the differential oracle consumes (T017). -->
  <ItemGroup>
    <Compile Include="lib/runtime/equiv_trace.cs" />
    <!-- Feature 025 (Option B): hand-written inbound-pump seam, not a codegen file. -->
    <Compile Include="lib/runtime/inbound_pump.cs" />
  </ItemGroup>

</Project>
