<!--
  SPDX-FileCopyrightText: Copyright (c) 2026 by Marcelle Kress von Wendland, The Olamni Research Group and Bancstreet Capital Partners Ltd, London, UK
  SPDX-License-Identifier: MIT

  REPO-WIDE C# LANGUAGE PIN — .NET 11 / C# 15 latest preview.

  Engineer directive 2026-08-27: "c#15 opt in approved and mandated".

  LangVersion 'preview' (NOT 'latest'):
    'latest'  = newest RELEASED language version for the active SDK  -> C# 14 on SDK 10
    'preview' = newest PREVIEW language version for the active SDK   -> C# 15 on SDK 11
  'preview' is forward-compatible: it resolves to C# 14 preview while SDK 10.0.302 is
  active and becomes C# 15 the moment the pinned SDK 11.0.100-preview.7 is selected by
  global.json. No second edit is needed at cutover.

  Directory.Build.props is imported BEFORE each .csproj, so any project that sets its own
  <LangVersion> still wins. Those overrides were changed to 'preview' in the same commit.

  NOT covered on purpose:
    gleam_quic/profile_c/_build/**   vendored third-party (msquic 9.0, clogutils 8.0)
    out/csharp/**                    generated by codeconv; fix the generator, not the output
-->
<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <!-- Preview language features on a preview SDK require explicit opt-in. -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <!-- Suppress the "using a preview SDK" nag; the preview is deliberate and pinned. -->
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>

</Project>
