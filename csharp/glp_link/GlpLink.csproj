<!--
  GlpLink — the hand-authored, CLOBBER-SAFE C# link-layer overlay (feature 025).

  WHY THIS PACKAGE EXISTS (FR-057 / architecture-context.md §2.3):
    codeconv's dart_csharp mirror regenerates one .cs per source .dart under
    out/csharp/lib/** and glp_runtime_net/. Any hand-authored .cs placed at a
    path that maps to a Dart preimage is OVERWRITTEN by the next mirror/scaffold/
    codegen. This package has NO Dart preimage and lives OUTSIDE out/csharp and
    the gitignored glp_runtime_net/, so the regen oracle never names it as an
    output. It is the permanent home for the link primitives' C# bodies, the
    reliability sublayer, the LinkTransport seam, and the native transport leaves.

  It references the build-gated out/csharp product (glp_runtime_net) so it reuses
  the already-byte-parity PayloadSerializer, GlobalWritersTable, and MadContext
  rather than forking them.

  Unlike out/csharp (EnableDefaultCompileItems=false + Converted.props), this is
  hand-authored code: the default **/*.cs glob compiles everything here.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.Link</RootNamespace>
    <AssemblyName>glp_link</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The byte-parity serializer + the two MadContext seams the reliability
       sublayer wires into (architecture-context.md §1, §4). -->
  <ItemGroup>
    <ProjectReference Include="..\..\out\csharp\glp_runtime_net.csproj" />
  </ItemGroup>

  <!-- Expose internals (WebSocketOverQuic etc.) to the test assembly for unit-level
       framing regression tests (036 review fix, finding #1). -->
  <ItemGroup>
    <InternalsVisibleTo Include="glp_link.tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetMQ" Version="4.0.4.3" />
  </ItemGroup>

</Project>
