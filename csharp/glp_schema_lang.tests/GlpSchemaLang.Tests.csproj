<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlpRuntime.SchemaLang.Tests</RootNamespace>
    <!-- Must match the production project's InternalsVisibleTo. -->
    <AssemblyName>glp_schema_lang.tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Golden CDDL files (FR-005 determinism) travel with the test binary. -->
  <ItemGroup>
    <None Include="golden\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="schemas\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_schema_lang\GlpSchemaLang.csproj" />
    <ProjectReference Include="..\glp_wire_registry\GlpWireRegistry.csproj" />
    <ProjectReference Include="..\glp_crdtmsg\GlpCrdtMsg.csproj" />
  </ItemGroup>

</Project>
