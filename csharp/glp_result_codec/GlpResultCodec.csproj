<!--
  GlpResultCodec — net-new, CLOBBER-SAFE C# result-envelope round-trip codec
  (feature 038-result-codec-and-framecodec-ride).

  WHY THIS PACKAGE EXISTS (same rule as GlpIlCodec.csproj / GlpLink.csproj):
    codeconv's dart_csharp mirror regenerates one .cs per source .dart under
    out/csharp/lib/** and glp_runtime_net/. A hand-authored .cs at a path that
    maps to a Dart preimage would be OVERWRITTEN by the next mirror/scaffold.
    This package has NO Dart preimage and lives OUTSIDE out/csharp and the
    gitignored glp_runtime_net/, so the regen oracle never names it as output.
    It is the permanent home for the hand-authored result-envelope codec body.

  It is fully STANDALONE: it defines its own value-type term model and reproduces
  the shipped 029 byte conventions in PARALLEL (FR-007 — 029 is the C# byte
  oracle only; byte-parity is a property of the bytes, not of shared code). It
  therefore takes NO ProjectReference on glp_runtime_net / glp_il_codec / GlpLink.

  Dart is the source of truth for the cross-runtime bytes (R9); this C# slice is
  byte-identical to glp_runtime/lib/codec/result_envelope_codec.dart et al.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.ResultCodec</RootNamespace>
    <AssemblyName>glp_result_codec</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS0649;CS0169</WarningsAsErrors>
  </PropertyGroup>

  <!-- The xUnit test project lives in tests/; keep its sources out of the lib build. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- Single ProjectReference: the ZERO-DEPENDENCY glp_wire_registry leaf (feature 041 T006).
       The "NO ProjectReference" stance above is about the heavy runtime / il_codec / GlpLink,
       which still holds — the registry is a pure constants leaf, so referencing it for the ONE
       payload-type byte (SC-010) does NOT reintroduce a runtime dependency or alter any wire byte. -->
  <ItemGroup>
    <ProjectReference Include="..\glp_wire_registry\GlpWireRegistry.csproj" />
  </ItemGroup>

</Project>
