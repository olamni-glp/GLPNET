<!--
  GlpEngineHost — the long-lived GLP engine host process (feature 061, T001; R5:
  a NEW separately startable component, not a mode flag on the existing REPL).
  Owns the engine state, serves one thin client over TCP loopback
  (contracts/wire-protocol.md), snapshots at quiescence (contracts/snapshot-store.md),
  and restores/resumes on restart.

  CLOBBER-SAFE: no Dart preimage, lives OUTSIDE out/csharp.

  References:
    - out/csharp/glp_runtime_net : the converted engine + runtime (GlpEngine, scheduler).
    - glp_link                   : TcpTransport + FrameCodec (the wire, D1).
    - glp_result_codec           : 038 ResultEnvelope/ResultEnvelopeCodec (D2).
    - glp_split_protocol         : shared request/response payload types (T001).

  TargetFramework: net11.0 — engineer-mandated .NET 11 / C# 15 pin (2026-08-27);
  see GlpSplitProtocol.csproj note and the repo-root global.json + Directory.Build.targets.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.EngineHost</RootNamespace>
    <AssemblyName>glp_engine_host</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);CS0649;CS0169</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\out\csharp\glp_runtime_net.csproj" />
    <ProjectReference Include="..\glp_link\GlpLink.csproj" />
    <ProjectReference Include="..\glp_result_codec\GlpResultCodec.csproj" />
    <ProjectReference Include="..\glp_split_protocol\GlpSplitProtocol.csproj" />
    <!-- 064 US3 (T023): CompiledIlEnvelope verify/decode for the LOAD_IL /
         RUN_GOAL_IL execute path (IlExecutePath.cs). NOTE the compiler cannot be
         factored out at the ASSEMBLY level: glp_runtime_net is monolithic
         (runtime sources reference GlpRuntime.Compiler) and the text kinds keep
         the full pipeline during the deprecation window. The enforced
         no-compiler boundary is the IlExecutePath type — asserted by
         glp_split_protocol.tests/CompilerAbsenceTests over its compiled IL. -->
    <ProjectReference Include="..\glp_il_codec\GlpIlCodec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 061 T021: PGlite-primary snapshot store (store/PgliteSnapshotStore.cs) —
         same version as the 041 precedent (glp_crdtmsg NpgsqlColabOpDb). -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlpEngineHost.Tests" />
  </ItemGroup>

</Project>
