<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlpRuntime.CrdtMsg.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Golden corpus fixtures (the 038 golden discipline) travel with the test binary. -->
  <ItemGroup>
    <None Include="goldens\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 049 shared decision vectors (SSOT in specs/ — linked, never copied by hand). -->
  <ItemGroup>
    <None Include="..\..\specs\049-wave1-guard-link-acceptance\contracts\vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 058 shared macaroon-v2 conformance corpus (copied byte-exact from buildkit
       specs/058-yngenios-4service-dogfood/vectors/macaroon-v2; manifest pins sha256 of exact bytes,
       .gitattributes -text guards against EOL re-rendering — the 057 parity-drift lesson). -->
  <ItemGroup>
    <None Include="conformance\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_crdtmsg\GlpCrdtMsg.csproj" />
    <ProjectReference Include="..\glp_wire_registry\GlpWireRegistry.csproj" />
  </ItemGroup>

</Project>
