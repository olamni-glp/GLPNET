<!--
  glp_split_protocol.tests — xUnit suite for the 064 US3 IL request kinds
  (T024; contracts/il-request-kind.md): LOAD_IL/RUN_GOAL_IL round-trip, the
  062 hardening refusal taxonomy as typed responses, the text/IL never-mixed
  session gate, the corpus equivalence sweep (IL path == text path over
  programs/tests/typed, SC-003), and the compiler-absence build assertion over
  the engine host's IL execute path.

  csproj shape mirrors glp_engine_host.tests (the repo's per-project
  `dotnet test csharp/<project>` suite convention — no solution file).

  TargetFramework: net11.0 — engineer-mandated .NET 11 / C# 15 pin (2026-08-27);
  see GlpSplitProtocol.csproj note and the repo-root global.json + Directory.Build.targets.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_split_protocol\GlpSplitProtocol.csproj" />
    <ProjectReference Include="..\glp_engine_host\GlpEngineHost.csproj" />
    <ProjectReference Include="..\glp_repl_client\GlpReplClient.csproj" />
    <ProjectReference Include="..\glp_il_codec\GlpIlCodec.csproj" />
  </ItemGroup>

</Project>
