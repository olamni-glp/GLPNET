<!--
  GlpCrdtMsg — the CRDT multi-format messaging feature (feature 041-crdtmsg-mvp, T001/T002).

  CLOBBER-SAFE (same rule as GlpLink/GlpIlCodec/GlpResultCodec/GlpWireRegistry): no Dart preimage,
  lives OUTSIDE out/csharp and the gitignored glp_runtime_net/, so the codeconv regen oracle never
  names it as an output. Permanent home for the hand-authored messaging bodies.

  References:
    - glp_wire_registry : the single payload-type/functor table (SC-010).
    - glp_result_codec  : Section-15 TermCodec + ByteReader/ByteWriter + loud-fail discipline (binary surface inner).
    - glp_link          : FrameCodec / WS framing + the QUIC/WS transport leaf (transport of record, 036).
  NOTE (T002 deviation, flagged): glp_quick_host is an OutputType=Exe stdio host, not a library. Per
  contract C20 / quickstart, the SC-009 demonstrator LAUNCHES glp_quick_host.exe as a side-process
  behind the ILinkTransport seam (route/, T052) — so it is intentionally NOT a compile-time
  ProjectReference here (that would drag MsQuic native deps into every unit-test build).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.CrdtMsg</RootNamespace>
    <AssemblyName>glp_crdtmsg</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      THE DURABLE HALF of the _pumpCts fix (era 102, round 16). A CancellationTokenSource field was
      declared, cancelled and disposed in DisposeAsync, and NEVER ASSIGNED — so the shutdown path
      read as if it owned the four long-running loops while both statements were unconditional
      no-ops. The compiler had reported it as CS0649 from the commit that introduced it; nothing
      promoted the warning, so nothing failed and it survived fifteen adversarial review rounds.

      This is the same declared-but-unconsumed shape this lane broadcast fleet-wide as
      `declared-unconsumed-guard` — "a guard that did not look reads identically to one that
      passed". Deleting the one field fixes the instance; promoting the diagnostic fixes the class.

        CS0649 - field is never assigned to and will always have its default value
        CS0169 - field is never used
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0649;CS0169</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_wire_registry\GlpWireRegistry.csproj" />
    <ProjectReference Include="..\glp_result_codec\GlpResultCodec.csproj" />
    <ProjectReference Include="..\glp_link\GlpLink.csproj" />
  </ItemGroup>

  <!-- Surface + crypto deps (T002). System.Text.Json is in-box for net10 (no package). -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="NSec.Cryptography" />
    <!-- 048 T012: PGlite-backed op-WAL (store/NpgsqlColabOpDb.cs). Same version as the buildkit
         sibling C# tiers (beacon/host/Beacon.Host.csproj, YngeniOS.Persistence) — lock-step schema. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="glp_crdtmsg.tests" />
    <!-- The test ASSEMBLY is named after the project file (GlpCrdtMsg.Tests), not the
         directory. The entry above names an assembly that does not exist, so internals were
         never actually visible to the tests - a latent defect nothing had leaned on until a
         test seam needed it. -->
    <InternalsVisibleTo Include="GlpCrdtMsg.Tests" />
  </ItemGroup>

</Project>
