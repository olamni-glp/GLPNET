<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ynet_client.tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ynet_client\YnetClient.csproj" />
    <!-- The M6-d tests drive the REAL client channel the REAL supervisor uses, not a hand-rolled
         socket: a test that spoke a private protocol would prove the endpoint answers something and
         prove nothing about whether the supervisor can host the client. -->
    <ProjectReference Include="..\glp_repl_client\GlpReplClient.csproj" />
    <!-- The end-to-end M6-d test drives the REAL Supervisor hosting the REAL client binary
         (engineer ruling Q-G35-02 -> B: composition from proven parts is not sufficient to ship). -->
    <ProjectReference Include="..\glp_supervisor\GlpSupervisor.csproj" />
  </ItemGroup>

</Project>
