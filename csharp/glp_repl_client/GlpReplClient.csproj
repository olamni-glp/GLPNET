<!--
  GlpReplClient — the thin terminal REPL client for the 061 split (T002; R7:
  a minimal client holding NO local language context — the engine bootstraps
  the prelude, FR-003). Renders 038 envelope results; distinguishes transport
  failure from goal failure (FR-007).

  CLOBBER-SAFE: no Dart preimage, lives OUTSIDE out/csharp.

  References glp_link (TcpTransport + FrameCodec) + glp_split_protocol ONLY —
  no direct runtime project reference (R7 thin client).

  TargetFramework: net11.0 — engineer-mandated .NET 11 / C# 15 pin (2026-08-27);
  see GlpSplitProtocol.csproj note and the repo-root global.json + Directory.Build.targets.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.ReplClient</RootNamespace>
    <AssemblyName>glp_repl_client</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_link\GlpLink.csproj" />
    <ProjectReference Include="..\glp_split_protocol\GlpSplitProtocol.csproj" />
    <!-- 038 envelope decode for rendering RESULT responses (T012). glp_result_codec is
         fully STANDALONE (its only ref is the zero-dependency glp_wire_registry constants
         leaf) — adding it keeps the R7 thin-client stance intact: no runtime project, no
         language context, just the pure value-type codec the wire contract mandates. -->
    <ProjectReference Include="..\glp_result_codec\GlpResultCodec.csproj" />
    <!-- 064 US3 (T022, contracts/il-request-kind.md rule 5): THE COMPILER MOVES
         INTO THE CLIENT. In `-path il` sessions the client compiles locally
         (full pipeline via GlpEngine) and ships CompiledIlEnvelope frames; the
         engine executes without compiling. The R7 thin-client stance now holds
         for TEXT sessions only — the IL session deliberately carries the
         language context client-side (that is the point of US3). -->
    <ProjectReference Include="..\..\out\csharp\glp_runtime_net.csproj" />
    <ProjectReference Include="..\glp_il_codec\GlpIlCodec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlpEngineHost.Tests" />
  </ItemGroup>

</Project>
