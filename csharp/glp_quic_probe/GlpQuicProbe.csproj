<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>glp_quic_probe</AssemblyName>
    <RootNamespace>GlpQuicProbe</RootNamespace>
    <WarningsAsErrors>$(WarningsAsErrors);CS0649;CS0169</WarningsAsErrors>
    <!-- Reuse the shipped transport rather than re-implementing a listener. The point of this
         probe is to prove THE PRODUCTION PATH binds, not that some other listener can. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\glp_crdtmsg\GlpCrdtMsg.csproj" />
    <!-- ynet_transport carries the MsQuic DllImportResolver. WITHOUT it this probe reports
         IsSupported=False on every Linux host whose libmsquic is off the default loader path — a
         FALSE NEGATIVE, and the fleet publishes "no QUIC here" from it. This is an app, not a unit
         test, so the "don't drag native deps into test builds" objection in GlpCrdtMsg.csproj does
         not apply. -->
    <ProjectReference Include="..\ynet_transport\YnetTransport.csproj" />
  </ItemGroup>

</Project>
