<!--
  GlpSupervisor — the liveness + supervised-restart host for the 061 engine
  (T003; contracts/supervision.md). Hosts the engine as a child process behind
  a .NET BackgroundService: one binary runs as console (dev/test) and as a
  Windows service (deploy) — FR-025, Windows-first, contract portable.

  MVP liveness is HOST-TIMER ONLY (DEF-F1/§1.14: the self-prove GLP goal is
  proposal-only this wave — see FR-021).

  CLOBBER-SAFE: no Dart preimage, lives OUTSIDE out/csharp.

  TargetFramework: net10.0 — repo convention; see GlpSplitProtocol.csproj note.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpRuntime.Supervisor</RootNamespace>
    <AssemblyName>glp_supervisor</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <!-- T025/FR-025: the same binary hosts as a Windows service (deploy) and a
         console (dev/test) — contract portable. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- T025: the supervisor probes/restarts through shipped pieces rather than
         duplicating them (VIII): the engine host's snapshot store classes decide
         "is there a snapshot / which previous seq" (taxonomy fallback), and the
         thin client's ClientChannel carries the liveness PING (wire rule 7). -->
    <ProjectReference Include="..\glp_engine_host\GlpEngineHost.csproj" />
    <ProjectReference Include="..\glp_repl_client\GlpReplClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlpEngineHost.Tests" />
  </ItemGroup>

</Project>
