# Line-ending pins (059 T051 root cause: CRLF checkout of corpus.list corrupted
# the parity runner's block ids -> all 44 runtime goldens reported MISSING).
# The parity harness inputs and goldens are byte-compared evidence: always LF,
# on every host, regardless of core.autocrlf.
test/parity/*.list      text eol=lf
test/parity/**/*.golden text eol=lf
test/parity/goldens/**  text eol=lf
test/parity/*.sh        text eol=lf
test/parity/lib/*.sh    text eol=lf
test/*.sh               text eol=lf

# Cross-runtime parity CAPTURES are byte-compared evidence too. Without this pin
# every suite run rewrites all 34 results/*.out with CRLF and the tree reports
# dirty with ZERO content change (measured 2026-08-18) — noise that can mask a
# real parity diff, the same hazard the four-source timing elision closed.
test/parity/cross_runtime/results/*.out text eol=lf
