% ch-04-ex-07-recursive-numerics.glp
%
% This file presents §4.3's recursive-numerics Programs from book pp 37–38
% (PDF pp 49–50). All clauses byte-exact from the PDF, except 4.3.4 (tail
% factorial) deferred per Clarifications Q6 (would conflict with 4.3.3's
% factorial/2 via GLP non-contiguous-clauses constraint).
%
% Programs included:
%   §4.3.1 (book p 37): Peano arithmetic — plus/3, times/3, lesseq/2, natural_number/1
%   §4.3.2 (book p 37): integer arithmetic — double/2, average/3, abs/2, max/3
%   §4.3.3 (book p 37–38): factorial/2 (naive, 3 clauses)
%   §4.3.5 (book p 38): fib/2 (naive, 3 clauses; spawns O(2^N) processes)
%   §4.3.6 (book p 38): fib_linear/2 + fib_acc/4 (linear, 3 clauses)
%
% Out of scope for this file (per Q6 amendment):
%   §4.3.4 (book p 38): tail-recursive factorial — would conflict with §4.3.3's
%   factorial/2 in committed-choice + GLP non-contiguous-clauses constraint.
%   Learners can comment out 4.3.3's clauses to exercise the tail-recursive
%   version; see book p 38 for the source.

%% §4.3.1 (book p 37): Peano arithmetic.

%% plus base — 0 + Y = Y.
plus(0, Y, Y?).
%% plus recursive — s(X) + Y = s(X + Y).
plus(s(X), Y, s(Z?)) :- plus(X?, Y?, Z).

%% times base — 0 * _ = 0.
times(0, _, 0).
%% times recursive — s(X) * Y = X*Y + Y; tuple guard permits Y? multi-reader.
times(s(X), Y, Z?) :- tuple(Y?) | times(X?, Y?, XY), plus(XY?, Y?, Z).

%% lesseq base — 0 ≤ X for any natural X (guarded by natural_number/1).
lesseq(0, X) :- natural_number(X?) | true.
%% lesseq recursive — s(X) ≤ s(Y) iff X ≤ Y.
lesseq(s(X), s(Y)) :- lesseq(X?, Y?).

%% natural_number base — 0 is a natural.
natural_number(0).
%% natural_number recursive — s(X) is natural if X is natural.
natural_number(s(X)) :- natural_number(X?).

%% §4.3.2 (book p 37): integer arithmetic.

%% double — Y = X * 2.
double(X, Y?) :- Y := X? * 2.
%% average — Avg = (X + Y) / 2.
average(X, Y, Avg?) :- Avg := (X? + Y?) / 2.

%% abs — non-negative case: pass-through.
abs(X, X?) :- X? >= 0 | true.
%% abs — negative case: negate.
abs(X, Y?) :- X? < 0 | Y := 0 - X?.

%% max — when X >= Y, X is max.
max(X, Y, X?) :- X? >= Y? | true.
%% max — when X < Y, Y is max.
max(X, Y, Y?) :- X? < Y? | true.

%% §4.3.3 (book p 37–38): naive factorial.

%% factorial(0) = 1.
factorial(0, 1).
%% factorial(1) = 1.
factorial(1, 1).
%% factorial(N) = N * factorial(N-1) for N > 1.
factorial(N, F?) :-
    N? > 1 |
    N1 := N? - 1,
    factorial(N1?, F1),
    F := N? * F1?.

%% §4.3.5 (book p 38): naive Fibonacci (spawns O(2^N) processes).

%% fib(0) = 0.
fib(0, 0).
%% fib(1) = 1.
fib(1, 1).
%% fib(N) = fib(N-1) + fib(N-2) for N > 1; both recursive calls spawn concurrently.
fib(N, F?) :-
    N? > 1 |
    N1 := N? - 1,
    N2 := N? - 2,
    fib(N1?, F1),
    fib(N2?, F2),
    F := F1? + F2?.

%% §4.3.6 (book p 38): linear Fibonacci with accumulator.

%% fib_linear entry — initialise fib_acc with seeds 0, 1.
fib_linear(N, F?) :- fib_acc(N?, 0, 1, F).

%% fib_acc base — N=0: result is the running A accumulator.
fib_acc(0, A, _, A?).
%% fib_acc recursive — N > 0: shift accumulators (A becomes B; B becomes A+B), recurse on N-1. AMENDED per Clarifications Q7: added number(B?) guard per Formal 4.3 (book's printed clause has B? appearing twice in body without a multi-reader-permissive guard; strict SRSW flags this).
fib_acc(N, A, B, F?) :-
    N? > 0, number(B?) |
    N1 := N? - 1,
    AB := A? + B?,
    fib_acc(N1?, B?, AB?, F).
