%% Profile C quicer provisioning (feature 049, US2; profile_c/README step 2).
%%
%% A minimal rebar3 app whose ONLY job is to fetch + build the `quicer` NIF (genuine in-process
%% QUIC via MsQuic) for the BEAM. The Gleam adapter points ERL_LIBS at this app's
%% _build/default/lib so `glpq_quic` (gleam_quic/src) can call quicer at runtime.
%%
%% Build (Linux/WSL; MSVC-less Windows cannot build msquic — see README):
%%   cd gleam_quic/profile_c && rebar3 compile
%%
%% Version note: 0.4.3 needs OTP >= 26 (`dynamic()` type); this host's WSL Ubuntu carries OTP 25,
%% where 0.2.15 is the newest compatible release (its NIF/msquic C build is identical in kind).
{deps, [{quicer, "0.2.15"}]}.
