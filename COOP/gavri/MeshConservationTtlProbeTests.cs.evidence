using System.Diagnostics;
using Olamnit.Kernel.Link;
using Olamnit.Kernel.Mesh;
using Xunit;
using Xunit.Abstractions;

namespace Olamnit.Kernel.Tests.Mesh;

/// <summary>
/// PROBE (investigation, not a shipped gate): does the mesh conservation identity
/// <c>Σ Originated == Σ Delivered + Σ Dropped</c> still hold once a message's
/// <see cref="MeshRuntimeOptions.MessageTtl"/> has elapsed?
///
/// Motivation — a structural read of <see cref="MeshNodeRuntime"/>: the in-flight table <c>_pending</c> has
/// exactly THREE mutation sites (declare / insert-on-send / remove-in-the-TTL-expiry-branch). There is no
/// delivery-driven removal path, so a message that WAS delivered at its destination stays pending at its
/// ORIGIN until TTL, at which point <c>StageExpiredToPartitionQueue</c> increments <c>_dropped</c>
/// unconditionally. Hypothesis: past TTL a delivered message is counted BOTH Delivered (at the destination)
/// AND Dropped (at its origin) ⇒ the identity breaks.
///
/// This file only MEASURES. It asserts the parts that are certain (the message really was delivered) and
/// reports the conservation sums to test output rather than encoding the hypothesis as a pass condition —
/// so the probe cannot itself manufacture the result it is testing.
///
/// NOTE: this does NOT touch <c>MeshRoutingTests</c>, which is a shipped CI gate — and which exercises
/// <see cref="MeshRouter"/> (no retransmit, no TTL, immediate conserved drops), a DIFFERENT class from the
/// <see cref="MeshNodeRuntime"/> probed here.
/// </summary>
public sealed class MeshConservationTtlProbeTests
{
    private const ushort A = 1, B = 2;

    private readonly ITestOutputHelper _output;
    public MeshConservationTtlProbeTests(ITestOutputHelper output) => _output = output;

    private sealed class Inbox
    {
        private readonly List<(ushort Src, byte[] Payload)> _items = new();
        public void Deliver(ushort src, byte[] payload) { lock (_items) _items.Add((src, payload)); }
        public int Count { get { lock (_items) return _items.Count; } }
    }

    private static void Wire(MeshNodeRuntime x, ushort xId, MeshNodeRuntime y, ushort yId, string name)
    {
        var (ex, ey) = LoopbackLink.CreatePair(name);
        Assert.True(x.AddNeighbor(yId, ex, LinkScheme.Loopback));
        Assert.True(y.AddNeighbor(xId, ey, LinkScheme.Loopback));
    }

    private static async Task<bool> WaitUntilAsync(Func<bool> cond, TimeSpan timeout)
    {
        var sw = Stopwatch.StartNew();
        while (sw.Elapsed < timeout)
        {
            if (cond()) return true;
            await Task.Delay(15);
        }
        return cond();
    }

    /// <summary>
    /// One A→B message over a direct link, with a deliberately SHORT TTL so the probe finishes fast.
    /// (The shipped default is 5 s and the 059 bench profile raises it to 120 s; lowering the TTL is the
    /// cheap way to observe post-TTL behaviour without a long wall-clock wait.)
    /// Sampled twice: well INSIDE the TTL window, then well OUTSIDE it.
    /// </summary>
    [Fact]
    public async Task Conservation_SampledInsideThenOutsideTheTtlWindow()
    {
        var ttl = TimeSpan.FromMilliseconds(400);
        var opts = MeshRuntimeOptions.Default with { MessageTtl = ttl };

        var atB = new Inbox();
        var a = new MeshNodeRuntime(A, (_, _) => { }, options: opts);
        var b = new MeshNodeRuntime(B, atB.Deliver, options: opts);

        await using (a)
        await using (b)
        {
            Wire(a, A, b, B, "AB");
            Assert.True(await WaitUntilAsync(() => a.TryNextHop(B, out _), TimeSpan.FromSeconds(5)),
                "A should converge to a next hop for B");

            var outcome = await a.SendAsync(B, new byte[] { 0x01, 0x02, 0x03 });
            _output.WriteLine($"SendAsync outcome = {outcome}");

            // CERTAIN: the message really is delivered. If this fails the probe is meaningless.
            Assert.True(await WaitUntilAsync(() => atB.Count >= 1, TimeSpan.FromSeconds(5)),
                "B never received the message — probe invalid");

            // ── Sample 1: INSIDE the TTL window (this is the regime the shipped suites assert in) ──
            long origIn = a.Originated + b.Originated;
            long delivIn = a.Delivered + b.Delivered;
            long dropIn = a.Dropped + b.Dropped;
            _output.WriteLine($"INSIDE  ttl: originated={origIn} delivered={delivIn} dropped={dropIn} " +
                              $"=> delivered+dropped={delivIn + dropIn} (identity holds: {origIn == delivIn + dropIn})");

            // ── Sample 2: OUTSIDE the TTL window — well past expiry + a retransmit tick ──
            await Task.Delay(ttl + TimeSpan.FromMilliseconds(900));

            long origOut = a.Originated + b.Originated;
            long delivOut = a.Delivered + b.Delivered;
            long dropOut = a.Dropped + b.Dropped;
            _output.WriteLine($"OUTSIDE ttl: originated={origOut} delivered={delivOut} dropped={dropOut} " +
                              $"=> delivered+dropped={delivOut + dropOut} (identity holds: {origOut == delivOut + dropOut})");

            _output.WriteLine(origOut == delivOut + dropOut
                ? "RESULT: identity SURVIVES past TTL — the double-count hypothesis is REFUTED."
                : $"RESULT: identity BREAKS past TTL — delivered+dropped ({delivOut + dropOut}) != originated ({origOut}). " +
                  "A delivered message is also counted dropped at its origin.");

            // The one thing that must be true either way: the message was delivered exactly once.
            Assert.Equal(1, atB.Count);
            Assert.Equal(1, delivOut);
        }
    }
}
