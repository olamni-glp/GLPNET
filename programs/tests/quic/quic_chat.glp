% quic_chat.glp — CANONICAL interactive two-way chat between the two C# REPL hosts over ONE
% full-duplex genuine QUIC link (authored by the Olamnit session; ratified canonical by Gabi,
% 2026-07-12 reconciliation — the per-message one-bind variant is preserved as
% quic_chat_onebind.glp). Turn-based: each round, each host edits its OWN my_lines clause, the
% listener re-arms main(olamnit, R). and the connector dials main(gavri, R). — each side's R
% returns the peer's lines for the round.
-mode(system).
CrdtModel ::= none ; state_based ; op_based.
Policy    ::= policy(Stream(Constant), Stream(Constant), Stream(Constant)).
Section   ::= section(Integer, Stream(Integer)).
CrdtMsg   ::= crdtmsg(Constant, Constant, Constant, Integer, Policy, CrdtModel, Stream(Section)).

procedure main(AgentId?, Stream(_)).
main(Me, Report?) :- Me? =?= olamnit |
    server_listener(link_id("quic", ep("192.168.0.136", 9200), 1), Link, _),
    run_chat(Link?, olamnit, gavri, Report).
main(Me, Report?) :- Me? =?= gavri |
    client_connector(link_id("quic", ep("192.168.0.136", 9200), 1), Link, _),
    run_chat(Link?, gavri, olamnit, Report).

procedure run_chat(Link(_, _)?, Constant?, Constant?, Stream(_)).
run_chat(ch(In, Out?), Me, Peer, Report?) :-
    ground(Me?), ground(Peer?) |
    my_lines(Me?, Lines),
    send_lines(Me?, Peer?, 1, Lines?, Out),
    collect(In?, Report).

procedure send_lines(Constant?, Constant?, Integer?, Stream(_)?, Stream(_)).
send_lines(From, To, N, [Text|Rest], [crdtmsg(Text?, From?, To?, N?, policy([], [], []), none, [])|Out?]) :-
    ground(From?), ground(To?), ground(N?), ground(Text?) |
    N1 := N? + 1,
    send_lines(From?, To?, N1?, Rest?, Out).
send_lines(_, _, _, [], []) :- true.

procedure collect(Stream(_)?, Stream(_)).
collect([M|In], [M?|Rest?]) :- ground(M?) | collect(In?, Rest).
collect([], []).

procedure my_lines(Constant?, Stream(_)).
my_lines(Me, ["olamnit here — live over genuine QUIC on 9200. do you read me, gavri?", "this is a real full-duplex link: you should see this as your R."]) :- Me? =?= olamnit | true.
my_lines(Me, ["gavri back on the link. your T018 run is superb - all pulled and synced through well_typed_clause dad1ab2b (303/303), both branches identical.", "coordination: gabi wants gavri working T018 too. to avoid collision: which unit are you on NOW? proposal: you finish type_environment_builder, gavri takes clause_validation + the checkModule entry. confirm or counter on this link or via a git push.", "MVP status: gabi has your store_put/store_get proposal; his scope call (kernel pair in MVP vs host-owned log) is pending - do not start the resume hook yet."]) :- Me? =?= gavri | true.
