% programs/self.glp — Root type and procedure declarations
% This is the outermost ancestor in the scope chain, visible to every project.
-mode(system).

% =============================================================================
% TYPE DEFINITIONS
% =============================================================================

% Collections (parameterized)
Stream(X) ::= [] ; [X | Stream(X)].
OpenStream(X) ::= [X | Stream(X)].
DiffList(X) ::= Stream(X) \ Stream(X)?.

% Communication (parameterized)
Channel(In, Out) ::= ch(In, Out?).

% Primitive types
Constant ::= Number ; String.

% Arithmetic expressions
Exp ::= Number ; +(Exp, Exp) ; -(Exp, Exp) ; *(Exp, Exp) ; /(Exp, Exp) ; //(Exp, Exp) ; mod(Exp, Exp) ; neg(Exp).

% =============================================================================
% BUILTIN PROCEDURE DECLARATIONS (no clauses - implemented by runtime)
% =============================================================================

% Type guards
procedure integer(Integer?).
procedure number(Number?).
procedure string(String?).
procedure atom(String?).
procedure constant(Constant?).
procedure compound(_?).
procedure tuple(_?).
procedure list(_?).
procedure is_list(_?).
procedure module(_?).
% Groundness guards
procedure ground(_?).
procedure known(_?).
procedure unknown(_?).
procedure no_readers(_?).

% Time guards
procedure wait(Number?).
procedure wait_until(Number?).

% Arithmetic comparison guards
procedure <(Exp?, Exp?).
procedure >(Exp?, Exp?).
procedure =<(Exp?, Exp?).
procedure >=(Exp?, Exp?).
procedure =:=(Exp?, Exp?).
procedure =\=(Exp?, Exp?).

% Standard-order term-comparison guards (Number < String < compound)
procedure @<(_?, _?).
procedure @>(_?, _?).
procedure @=<(_?, _?).
procedure @>=(_?, _?).

% Equality guard
procedure =?=(_?, _?).

% Univ operations (term ↔ list conversion)
procedure =..(_, Stream(_)?).      % Compose: Stream? → Compound
procedure ..=(Stream(_), _?).      % Decompose: Compound? → Stream

% MWM (Mutual Write Merge) runtime primitives
procedure _allocate_mutual_reference(_, _).
procedure is_mutual_ref(_?).
procedure _stream_append(_?, _?, _).
procedure _close_mutual_reference(_?).

% madGLP network primitives
procedure _send(_?, _?, _?).

% Output (system predicate)
procedure _output(_?).

% UI output (system predicate) — madGLP-spec §12.5. Delivers ONE ground term to the
% local UI sink. Does NOT globalize, does NOT add to M_p, mints no global link: purely
% local. A SEPARATE sink from _output (§12.6: UI and network output are distinct
% channels). The ground(X?) gate lives in the send_to_ui/1 wrapper.
procedure _send_to_ui(_?).

% =============================================================================
% SINGLE-UNIT-CLAUSE PROCEDURES (DEFINED GUARDS)
% =============================================================================

% Assignment (unification)
procedure =(_?, _).
X? = X.

% Difference list operations
procedure dl_append(DiffList(X)?, DiffList(X)?, DiffList(X)).
dl_append(A\B?, B\C?, A?\C).

procedure dl_to_list(DiffList(X)?, Stream(X)).
dl_to_list(L\[], L?).

% Channel operations
procedure new_channel(Channel(X, Y), Channel(Y, X)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

procedure send(X?, Channel(Y, Stream(X))?, Channel(Y, Stream(X))).
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

procedure receive(X, Channel(Stream(X), Y)?, Channel(Stream(X), Y)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).

% =============================================================================
% ARITHMETIC ASSIGNMENT (:=/2)
% =============================================================================

procedure :=(Number, Exp?).

% Base case: plain number
Result? := N :- number(N?) | Result = N?.

% Addition
Result? := X + Y :-
  number(X?), number(Y?) |
  '_add'(X?, Y?, Result).
Result? := X + Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? + Y1?.

% Subtraction
Result? := X - Y :-
  number(X?), number(Y?) |
  '_sub'(X?, Y?, Result).
Result? := X - Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? - Y1?.

% Multiplication
Result? := X * Y :-
  number(X?), number(Y?) |
  '_mul'(X?, Y?, Result).
Result? := X * Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? * Y1?.

% Division (always returns float)
Result? := X / Y :-
  number(X?), number(Y?), Y? =\= 0 |
  '_div'(X?, Y?, Result).
_ := X / Y :-
  number(X?), number(Y?), Y? =:= 0 |
  abort("Division by zero").
Result? := X / Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? / Y1?.

% Integer division
Result? := X // Y :-
  integer(X?), integer(Y?), Y? =\= 0 |
  '_idiv'(X?, Y?, Result).
_ := X // Y :-
  integer(X?), integer(Y?), Y? =:= 0 |
  abort("Integer division by zero").
Result? := X // Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? // Y1?.

% Modulo
Result? := X mod Y :-
  integer(X?), integer(Y?), Y? =\= 0 |
  '_mod'(X?, Y?, Result).
_ := X mod Y :-
  integer(X?), integer(Y?), Y? =:= 0 |
  abort("Modulo by zero").
Result? := X mod Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? mod Y1?.

% Unary negation
Result? := -X :-
  number(X?) |
  '_neg'(X?, Result).
Result? := -X :-
  otherwise |
  X1 := X?,
  Result := -X1?.

% Absolute value
Result? := abs(X) :-
  number(X?) |
  '_abs'(X?, Result).
Result? := abs(X) :-
  otherwise |
  X1 := X?,
  Result := abs(X1?).

% Square root
Result? := sqrt(X) :-
  number(X?), X? >= 0 |
  '_sqrt'(X?, Result).
_ := sqrt(X) :-
  number(X?), X? < 0 |
  abort("Square root of negative number").
Result? := sqrt(X) :-
  otherwise |
  X1 := X?,
  Result := sqrt(X1?).

% Sine
Result? := sin(X) :-
  number(X?) |
  '_sin'(X?, Result).
Result? := sin(X) :-
  otherwise |
  X1 := X?,
  Result := sin(X1?).

% Cosine
Result? := cos(X) :-
  number(X?) |
  '_cos'(X?, Result).
Result? := cos(X) :-
  otherwise |
  X1 := X?,
  Result := cos(X1?).

% Tangent
Result? := tan(X) :-
  number(X?) |
  '_tan'(X?, Result).
Result? := tan(X) :-
  otherwise |
  X1 := X?,
  Result := tan(X1?).

% Exponential
Result? := exp(X) :-
  number(X?) |
  '_exp'(X?, Result).
Result? := exp(X) :-
  otherwise |
  X1 := X?,
  Result := exp(X1?).

% Natural logarithm
Result? := ln(X) :-
  number(X?), X? > 0 |
  '_ln'(X?, Result).
_ := ln(X) :-
  number(X?), X? =< 0 |
  abort("Natural logarithm of non-positive number").
Result? := ln(X) :-
  otherwise |
  X1 := X?,
  Result := ln(X1?).

% Base-10 logarithm
Result? := log(X) :-
  number(X?), X? > 0 |
  '_log10'(X?, Result).
_ := log(X) :-
  number(X?), X? =< 0 |
  abort("Logarithm of non-positive number").
Result? := log(X) :-
  otherwise |
  X1 := X?,
  Result := log(X1?).

% Power
Result? := pow(X, Y) :-
  number(X?), number(Y?) |
  '_pow'(X?, Y?, Result).
Result? := pow(X, Y) :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := pow(X1?, Y1?).

% Arc sine
Result? := asin(X) :-
  number(X?), X? >= -1, X? =< 1 |
  '_asin'(X?, Result).
_ := asin(X) :-
  number(X?), (X? < -1 ; X? > 1) |
  abort("Arc sine domain error: argument must be in [-1, 1]").
Result? := asin(X) :-
  otherwise |
  X1 := X?,
  Result := asin(X1?).

% Arc cosine
Result? := acos(X) :-
  number(X?), X? >= -1, X? =< 1 |
  '_acos'(X?, Result).
_ := acos(X) :-
  number(X?), (X? < -1 ; X? > 1) |
  abort("Arc cosine domain error: argument must be in [-1, 1]").
Result? := acos(X) :-
  otherwise |
  X1 := X?,
  Result := acos(X1?).

% Arc tangent
Result? := atan(X) :-
  number(X?) |
  '_atan'(X?, Result).
Result? := atan(X) :-
  otherwise |
  X1 := X?,
  Result := atan(X1?).

% Convert to integer
Result? := integer(X) :-
  number(X?) |
  '_integer'(X?, Result).
Result? := integer(X) :-
  otherwise |
  X1 := X?,
  Result := integer(X1?).

% Convert to real
Result? := real(X) :-
  number(X?) |
  '_real'(X?, Result).
Result? := real(X) :-
  otherwise |
  X1 := X?,
  Result := real(X1?).

% Round
Result? := round(X) :-
  number(X?) |
  '_round'(X?, Result).
Result? := round(X) :-
  otherwise |
  X1 := X?,
  Result := round(X1?).

% Floor
Result? := floor(X) :-
  number(X?) |
  '_floor'(X?, Result).
Result? := floor(X) :-
  otherwise |
  X1 := X?,
  Result := floor(X1?).

% Ceiling
Result? := ceil(X) :-
  number(X?) |
  '_ceil'(X?, Result).
Result? := ceil(X) :-
  otherwise |
  X1 := X?,
  Result := ceil(X1?).

% =============================================================================
% TIME (now/1)
% =============================================================================

procedure now(Integer).
now(T?) :- '_now'(T).

% =============================================================================
% UNIV (=../2, ..=/2)
% =============================================================================

% Composition: list → tuple
X? =.. [Y|Ys] :- list(Ys?) | '_list_to_tuple'([Y?|Ys?], X).

% Decomposition: compound → list
X =.. Y? :- compound(X?) | '_tuple_to_list'(X?, Y).

% =============================================================================
% MULTIWAY MERGE (mwm/2)
% =============================================================================
% MWM types and procedure declarations are omitted from the scope chain
% because the type system's DFA builder cannot handle compound type
% constructors like stream(Stream) in MwmInput. The clauses below are
% compiled for runtime use only — they are not type-checked.

mwm(In, Out?) :-
    '_allocate_mutual_reference'(Ref, Out),
    mwm_main(In?, Ref?).

mwm_main(In, Ref) :-
    is_mutual_ref(Ref?) |
    mwm1(In?, Ref?, done, Done),
    close_when_done(Done?, Ref?).

mwm1([stream(Xs)|Streams], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mwm_copy(Xs?, Ref?, L?, M),
    mwm1(Streams?, Ref?, M?, R).
mwm1([merge(NewIn)|Streams], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mwm1(NewIn?, Ref?, L?, M),
    mwm1(Streams?, Ref?, M?, R).
mwm1([], _, L, L?).

mwm_copy([X|Xs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    stream_append(X?, Ref?, Ref1),
    mwm_copy(Xs?, Ref1?, L?, R).
mwm_copy([], _, L, L?).

close_when_done(done, Ref) :-
    is_mutual_ref(Ref?) |
    close_mutual_reference(Ref?).

stream_append(Value, RefIn, RefOut?) :-
    is_mutual_ref(RefIn?) |
    '_stream_append'(RefIn?, Value?, RefOut).

close_mutual_reference(Ref) :-
    is_mutual_ref(Ref?) |
    '_close_mutual_reference'(Ref?).

% =============================================================================
% LINK LAYER (feature 025) — types + GLP wrappers over the host kernels.
% Relocated from programs/lib/link.glp (Gabi-approved) so link programs call these
% universally like send/receive/new_channel; the host kernels are in csharp/glp_link
% (Dart mirror later) + registered in the type-checker builtinProcedures allowlist.
% =============================================================================
% LINK-LAYER TYPES (FR-006/013)
% =============================================================================

% A stable, ground link identity — the cross-instance analogue of an in-process
% global writer/reader name. Compound so it carries scheme + endpoint + a uniqueness
% nonce, all ground; never reused (the idempotency basis, FR-007).
Scheme   ::= String.
Endpoint ::= String ; ep(String, Integer).
Nonce    ::= Integer ; String.
LinkId   ::= link_id(Scheme, Endpoint, Nonce).

% A ground peer/agent identifier (may be a non-numeric compound — FR-037 total order).
AgentId  ::= String ; Integer ; peer(String, Integer).

% Establishment role — a deployment/NAT concern, INDEPENDENT of data direction (FR-004).
LinkRole ::= listener ; connector.

% Fault lattice carried as ORDINARY BOUND GROUND TERMS on the monitor stream (FR-043:
% never a fourth unification verdict). closed/2 is an INTENTIONAL terminal (Reason = eos
% for graceful [], or a user reason for link_close), distinct from tempFail/permFail.
Reason   ::= String.
Fault    ::= ok ; closed(LinkId, Reason) ; tempFail(LinkId, Reason) ; permFail(LinkId, Reason).
FaultStream ::= Stream(Fault).

% A live link end presented to GLP logic as a Channel so self.glp send/receive/mwm
% compose ABOVE the seam (FR-006): In = inbound ground-term stream, Out = outbound.
Link(In, Out) ::= Channel(Stream(In), Stream(Out)).

% The path-B rendezvous (NOT a link — its own address term; Nonce is meaningless here)
% and the in-band request token the connector emits / the listener surfaces (Option A).
Rendezvous ::= rendezvous(Scheme, Endpoint).
RequestMsg ::= request(LinkId, AgentId).

% =============================================================================
% HOST KERNEL DECLARATIONS (no clauses — implemented by the runtime, like _send)
% Modes: ? = consumed input; bare = produced output (the host fills In/Faults writers
% and drains the Out reader). Called quoted ('_link_setup' …) in the wrappers below.
% =============================================================================

procedure _link_setup(_?, _?, _, _?, _).
procedure _link_send(_?, _?, _?).
procedure _link_request(_?, _?, _, _?, _).
procedure _link_listen(_?, _?, _).
procedure _link_accept(_?, _?, _, _?, _).
procedure _link_monitor(_?, _).
procedure _link_close(_?, _?).

% =============================================================================
% ESTABLISHMENT (FR-001/002/003/004/007)
% =============================================================================

% Establish-or-reuse a link by ground LinkId in a given role; hand back the Link channel
% (In inbound, Out outbound) + the per-link Faults monitor stream. Idempotent at identity.
procedure link_setup(LinkId?, LinkRole?, Link(_, _), FaultStream).
link_setup(LinkId, Role, ch(In?, Out), Faults?) :-
    ground(LinkId?), ground(Role?) |
    '_link_setup'(LinkId?, Role?, In, Out?, Faults).

% Establish by LISTENING / by CONNECTING — thin role-specializations of link_setup
% (FR-002 path A). Which side listens is a deployment/NAT concern only (FR-004).
procedure server_listener(LinkId?, Link(_, _), FaultStream).
server_listener(LinkId, Link?, Faults?) :-
    ground(LinkId?) |
    link_setup(LinkId?, listener, Link, Faults).

procedure client_connector(LinkId?, Link(_, _), FaultStream).
client_connector(LinkId, Link?, Faults?) :-
    ground(LinkId?) |
    link_setup(LinkId?, connector, Link, Faults).

% =============================================================================
% ESTABLISHMENT PATH B — request / listen / accept handshake (FR-002, Option A)
% =============================================================================

% Initiate an in-band link-request handshake to a peer; on the peer's accept, both ends
% hold the equivalent established Link (converges on the same registry as path A — R-5).
procedure request_link(LinkId?, AgentId?, Link(_, _), FaultStream).
request_link(LinkId, ToPeer, ch(LinkIn?, LinkOut), Faults?) :-
    ground(LinkId?), ground(ToPeer?) |
    '_link_request'(LinkId?, ToPeer?, LinkIn, LinkOut?, Faults).

% The EXPLICIT producer of accept_link's RequestStream (Option A: the program SEES where
% requests come from). Binds the rendezvous, surfaces each inbound request token.
procedure request_listener(Rendezvous?, Stream(RequestMsg)).
request_listener(rendezvous(Scheme, Endpoint), Requests?) :-
    ground(Scheme?), ground(Endpoint?) |
    '_link_listen'(Scheme?, Endpoint?, Requests).

% Accept an inbound link-request for a LinkId this end will serve. Reads one request token
% off RequestStream; on a ground-equal match (=?=), establishes the equivalent Link. The
% stream is an OpenStream (non-empty): you accept an EXISTING request, so the closed-stream
% [] case does not arise here (a request-loop reads request_listener's Stream and hands the
% non-empty head view to accept_link) — this also makes the single clause coverage-complete.
procedure accept_link(LinkId?, OpenStream(RequestMsg)?, Link(_, _), FaultStream).
accept_link(LinkId, [request(LinkId2, FromPeer)|_], ch(LinkIn?, LinkOut), Faults?) :-
    ground(LinkId?), LinkId? =?= LinkId2? |
    '_link_accept'(LinkId?, FromPeer?, LinkIn, LinkOut?, Faults).

% =============================================================================
% DATA — send (ground-relay) / receive (FR-010/017/040/051)
% =============================================================================

% Send one GROUND term out over the link's Out stream (ground-relay: only ground terms
% cross — FR-010). The Channel-shaped face; pure stream-cons in the head (the self.glp
% send/3 shape), gated ground(Msg?) so no _w/_r/embedded reader ever reaches the wire.
procedure link_send(X?, Link(Y, X)?, Link(Y, X)).
link_send(Msg, ch(In, [Msg?|Out?]), ch(In?, Out)) :- ground(Msg?) | true.

% The LinkId-keyed sender face (backs out_relay): ships a ground term to a ground peer
% over the link named by a ground LinkId. The SRSW-clean corrected out_relay.
procedure out_relay(_?, LinkId?, AgentId?).
out_relay(Msg, LinkId, ToPeer) :-
    ground(Msg?), ground(LinkId?), ground(ToPeer?) |
    '_link_send'(Msg?, LinkId?, ToPeer?).

% The host-driven egress DRAINER behind the channel face link_send/3. link_send only
% conses onto Out; this is what carries those terms to the wire. The host lowers one
% instance per established link at setup (the A3 global_send shape): reading [Msg|Rest]
% SUSPENDS until the program conses, so no heap onBind is needed — the ordinary
% suspension/reactivation machinery drives egress. Out = [] is the graceful stream-end
% close (FR-024), distinct from the abrupt link_close/2.
procedure link_drain(Stream(X)?, LinkId?, AgentId?).
link_drain([Msg|Rest], LinkId, ToPeer) :-
    ground(Msg?), ground(LinkId?), ground(ToPeer?) |
    '_link_send'(Msg?, LinkId?, ToPeer?),
    link_drain(Rest?, LinkId?, ToPeer?).
link_drain([], LinkId, _) :-
    ground(LinkId?) |
    '_link_close'(LinkId?, eos).

% Receive the next term off the link's In stream (the self.glp receive/3 shape). The In
% tail is extended by the host ingress as frames arrive; an unarrived value SUSPENDS.
procedure link_recv(X, Link(X, Y)?, Link(X, Y)).
link_recv(Msg?, ch([Msg|In], Out?), ch(In?, Out)).

% =============================================================================
% FAULT MONITOR (FR-008/043-046)
% =============================================================================

% Obtain the per-link fault MONITOR STREAM for an established LinkId. Independently
% observable from the data path (FR-008): faults are bound ground terms read with
% existing guards, never a fourth verdict and never a logical Fail (FR-043/044).
procedure link_monitor(LinkId?, FaultStream).
link_monitor(LinkId, Faults?) :-
    ground(LinkId?) |
    '_link_monitor'(LinkId?, Faults).

% =============================================================================
% CLOSE (FR-024) — abrupt teardown (/1 default reason, /2 user reason); graceful
% close stays the stream-end [] on Out. Both run distributed GC + emit closed(LinkId,_).
% =============================================================================

procedure link_close(LinkId?).
link_close(LinkId) :- ground(LinkId?) | '_link_close'(LinkId?, abrupt).

procedure link_close(LinkId?, Reason?).
link_close(LinkId, Reason) :- ground(LinkId?), ground(Reason?) | '_link_close'(LinkId?, Reason?).
