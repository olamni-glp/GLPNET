Coverage + IL-parity harness for the antlr4-glp-grammar spike. Drives the parity comparator
(feature 069) and the legacy accept/reject coverage check (feature 065). The ANTLR-generated
front-end and the production engine come in transitively through the Parity/Bridge projects; the
harness only adds the ANTLR runtime it uses directly for the legacy coverage table.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0: engineer directive 2026-09-01, 'migrate all code to .net 11'; extends fleet ruling C-19 (.NET 11 / C# 15, 2026-08-27) beyond csharp/. LangVersion comes from the repo-root Directory.Build.targets. -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>glp_grammar_spike_harness</AssemblyName>
    <RootNamespace>GlpGrammarSpike</RootNamespace>
    <NoWarn>CS3021;CS0108;CS0114;CS0162;CS0219;CS8981;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parity brings the bridge (front-end A + gen + engine) and the il-codec oracle transitively. -->
    <ProjectReference Include="..\parity\Parity.csproj" />
  </ItemGroup>
</Project>
